{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/gitpash/agent-artifact-protocol/v0.1.1-draft/schemas/map.schema.json",
  "title": "AAP Map v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "zones"],
  "properties": {
    "version": {
      "type": "integer",
      "enum": [1],
      "description": "Map format version."
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "layout": { "$ref": "#/$defs/layoutObject" }
      }
    },
    "zones": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": { "$ref": "#/$defs/zoneObject" }
    },
    "overlays": {
      "type": "object",
      "additionalProperties": false,
      "description": "Prefer map.local.yaml (gitignored) instead of committing absolute paths.",
      "properties": {
        "local_paths": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "description": "Absolute path or workspace-relative path to a checkout root for a zone id."
          }
        }
      }
    },
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Opt-in profile ids. Unknown ids must not break parse."
        }
      }
    }
  },
  "$defs": {
    "pathOrPaths": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!.*\\.\\.)(?!/).*$",
          "description": "Path relative to resolved zone root; / separators; no .. or absolute."
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!.*\\.\\.)(?!/).*$"
          }
        }
      ]
    },
    "layoutObject": {
      "type": "object",
      "description": "Intent → path router. Core keys documented in SPEC; additional keys are extensions.",
      "properties": {
        "code": { "$ref": "#/$defs/pathOrPaths" },
        "tests": { "$ref": "#/$defs/pathOrPaths" },
        "artifacts": { "$ref": "#/$defs/pathOrPaths" },
        "scratch": { "$ref": "#/$defs/pathOrPaths" },
        "scripts": { "$ref": "#/$defs/pathOrPaths" },
        "infra": { "$ref": "#/$defs/pathOrPaths" },
        "proposals": { "$ref": "#/$defs/pathOrPaths" },
        "architecture": { "$ref": "#/$defs/pathOrPaths" }
      },
      "additionalProperties": { "$ref": "#/$defs/pathOrPaths" }
    },
    "remoteObject": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "minLength": 1 },
        "repo": {
          "type": "string",
          "description": "owner/name shorthand"
        },
        "id": { "type": "string" },
        "default_branch": { "type": "string" }
      },
      "anyOf": [
        { "required": ["url"] },
        { "required": ["repo"] },
        { "required": ["id"] }
      ]
    },
    "aapPointerObject": {
      "type": "object",
      "additionalProperties": false,
      "description": "Paths relative to resolved foreign root.",
      "properties": {
        "map": { "type": "string", "minLength": 1 },
        "spec": { "type": "string", "minLength": 1 },
        "version": { "type": "string" }
      }
    },
    "zoneObject": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "In-workspace root relative to workspace root. Required for internal zones."
        },
        "relation": {
          "type": "string",
          "enum": ["internal", "external"],
          "description": "Default internal when omitted."
        },
        "remote": { "$ref": "#/$defs/remoteObject" },
        "aap": { "$ref": "#/$defs/aapPointerObject" },
        "mirrors": {
          "type": "string",
          "minLength": 1,
          "description": "Workspace-relative path for mirror artifacts about this zone (esp. external)."
        },
        "kind": {
          "type": "string",
          "description": "Soft hint. Recommended: root|backend|frontend|infra|batch|mixed|external. Unknown allowed."
        },
        "access": {
          "type": "string",
          "enum": ["read-only", "read-write"]
        },
        "write": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["domain", "architect"]
          },
          "description": "Mutating mode allow-list (domain|architect). Empty array = no write grant. Use access: read-only for consume-only zones."
        },
        "layout": { "$ref": "#/$defs/layoutObject" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "relation": { "const": "external" } },
            "required": ["relation"]
          },
          "then": {
            "required": ["remote"]
          }
        },
        {
          "if": {
            "anyOf": [
              { "properties": { "relation": { "const": "internal" } }, "required": ["relation"] },
              { "not": { "required": ["relation"] } }
            ]
          },
          "then": {
            "required": ["path"]
          }
        }
      ]
    }
  }
}
